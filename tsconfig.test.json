{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "coverage", "dist", "lib"]
}
